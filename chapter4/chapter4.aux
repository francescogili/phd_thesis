\@writefile{lof}{\contentsline {figure}{\numberline {4.3}{\ignorespaces Combined deconvolution plots for $n=200$. In green, we plot draws of \( \cc@accent {"705E}{F}_{\scriptscriptstyle {G}} \) based on prior draws from \( G \sim \operatorname  {DP}(M \alpha ) \) with $\alpha \sim \mathrm  {Ga}(2,2)$ and prior precision $M =10$; in purple, draws from the isotonized posterior; in red, the average of these draws (approximating the posterior mean); in yellow, the (IIE); and in orange \( F_0 \).}}{150}{figure.caption.242}\protected@file@percent }
\newlabel{img:deconvolution_plots}{{4.3}{150}{Combined deconvolution plots for $n=200$. In green, we plot draws of \( \hat {F}_{\scriptscriptstyle {G}} \) based on prior draws from \( G \sim \operatorname {DP}(M \alpha ) \) with $\alpha \sim \mathrm {Ga}(2,2)$ and prior precision $M =10$; in purple, draws from the isotonized posterior; in red, the average of these draws (approximating the posterior mean); in yellow, the (IIE); and in orange \( F_0 \)}{figure.caption.242}{}}
\newlabel{img:deconvolution_plots@cref}{{[figure][3][4]4.3}{[1][149][]150}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.4}{\ignorespaces Combined deconvolution plots with calibrated uncertainty quantification for $n=200$. In green, we plot draws of \( \cc@accent {"705E}{F}_{\scriptscriptstyle {G}} \) based on prior draws from \( G \sim \operatorname  {DP}(M \alpha ) \) with $\alpha \sim \mathrm  {Ga}(2,2)$ and prior precision $M =10$; in pink, the calibrated credible bands from the isotonized posterior; in red, the average of these draws (approximating the posterior mean); in yellow, the (IIE); and in orange \( F_0 \).}}{151}{figure.caption.243}\protected@file@percent }
\newlabel{img:UQ}{{4.4}{151}{Combined deconvolution plots with calibrated uncertainty quantification for $n=200$. In green, we plot draws of \( \hat {F}_{\scriptscriptstyle {G}} \) based on prior draws from \( G \sim \operatorname {DP}(M \alpha ) \) with $\alpha \sim \mathrm {Ga}(2,2)$ and prior precision $M =10$; in pink, the calibrated credible bands from the isotonized posterior; in red, the average of these draws (approximating the posterior mean); in yellow, the (IIE); and in orange \( F_0 \)}{figure.caption.243}{}}
\newlabel{img:UQ@cref}{{[figure][4][4]4.4}{[1][150][]151}}
