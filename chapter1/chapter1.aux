\@writefile{lof}{\contentsline {figure}{\numberline {1.2}{\ignorespaces The BvM phenomenon as $n$ increases. The red dashed curve is the sampling law of $\cc@accent {"705E}\theta _n$ (centred at $\theta _0$); blue curves are posteriors from separately sampled datasets, each centred at its own $\cc@accent {"705E}\theta _n$. As $n$ grows all curves narrow, but each posterior stays centred at $\cc@accent {"705E}\theta _n$. The posterior width approximately matches the spread of the frequentist sampling distribution, so the $95\%$ credible set (shaded) achieves asymptotically correct frequentist coverage.}}{5}{figure.caption.6}\protected@file@percent }
\newlabel{fig: BvM schematic}{{1.2}{5}{The BvM phenomenon as $n$ increases. The red dashed curve is the sampling law of $\hat \theta _n$ (centred at $\theta _0$); blue curves are posteriors from separately sampled datasets, each centred at its own $\hat \theta _n$. As $n$ grows all curves narrow, but each posterior stays centred at $\hat \theta _n$. The posterior width approximately matches the spread of the frequentist sampling distribution, so the $95\%$ credible set (shaded) achieves asymptotically correct frequentist coverage}{figure.caption.6}{}}
\newlabel{fig: BvM schematic@cref}{{[figure][2][1]1.2}{[1][4][]5}}
